readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "bookshelf[publish,dataframes]>=1.0.0b1",
    "pandas>=2.2",
]

[dependency-groups]
dev = [
    "mypy>=1.11.2",
    "towncrier>=25.8.0",
]
