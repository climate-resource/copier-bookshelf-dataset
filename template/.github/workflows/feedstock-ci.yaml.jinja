name: Feedstock CI

on:
  pull_request:
    types: [opened, synchronize, reopened]
  push:
    branches:
      - main
  schedule:
    - cron: "17 3 * * 1"
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

jobs:
  bookshelf:
    name: Bookshelf
    uses: climate-resource/copier-bookshelf-dataset/.github/workflows/feedstock-ci.yaml@{{ _copier_conf.vcs_ref or _copier_answers._commit }}
    with:
      recipes: >-
        bookshelf.yaml
{% for recipe in extra_recipes %}
        bookshelf-{{ recipe }}.yaml
{% endfor %}
      main-ref: main
      api-base-url: ${{ '{{' }} vars.BOOKSHELF_API_BASE_URL || 'https://bookshelf.climateresource.com.au' }}
      sdk-version: {{ bookshelf_sdk_version | tojson }}
