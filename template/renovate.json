{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>climate-resource/.github//renovate/base"
  ],
  "copier": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Template releases need a manual review, so they get their own pull request as soon as they ship",
      "matchManagers": [
        "copier"
      ],
      "groupName": "bookshelf template",
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": "0 days",
      "addLabels": [
        "template-update"
      ],
      "automerge": false
    },
    {
      "description": "The reusable feedstock workflows are pinned to the Copier ref, so `copier update` moves them, not Renovate",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "climate-resource/copier-bookshelf-dataset"
      ],
      "enabled": false
    }
  ]
}
