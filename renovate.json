{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "timezone": "Australia/Melbourne",
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group non-major updates, let releases settle before proposing",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The rendered fixtures are ctt output, so Renovate never edits them directly",
      "matchFileNames": ["tests/regression/ctt/**"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned inline in the template and the workflows, annotated for Renovate",
      "managerFilePatterns": ["/^template/.+$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+[A-Za-z_]+: ?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "ruff pinned as a uvx version in the Makefiles",
      "managerFilePatterns": ["/(^|/)Makefile(\\.jinja)?$/"],
      "matchStrings": ["uvx ruff@(?<currentValue>\\S+)"],
      "depNameTemplate": "ruff",
      "datasourceTemplate": "pypi"
    }
  ]
}
